# ── control-api process (Railway / Fly / Render / VPS) ───────────────────────
# Copy to .env on your host. Never commit real secrets.

# Bind address (containers: 0.0.0.0)
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3001

# development | staging | production — production enables strict validation
DEPLOY_ENV=development

# Optional TOML path (defaults to ./config.toml if present)
# SOLANA_ARB_CONFIG=/app/config.toml

# ── Required in production/staging ───────────────────────────────────────────
# Comma-separated Solana JSON-RPC URLs (Helius, QuickNode, Triton, etc.)
SOLANA_ARB_RPC__ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Solana WebSocket / Yellowstone (comma-separated)
SOLANA_ARB_WEBSOCKET__ENDPOINTS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional REST auth — when set, /api/* requires Bearer or x-api-key (health + /ws exempt)
CONTROL_API_INSECURE_SKIP_AUTH=1
# ── Safety defaults (paper mode) ─────────────────────────────────────────────
SOLANA_ARB_FEATURES__DRY_RUN=true
SOLANA_ARB_FEATURES__ENABLE_LIVE_TRADING=false

# ── Live trading only (never on Vercel — host env only) ─────────────────────
# SOLANA_ARB_CONFIG=config.mainnet.toml
# SOLANA_ARB_FEATURES__DRY_RUN=false
# SOLANA_ARB_FEATURES__ENABLE_LIVE_TRADING=true
# SOLANA_ARB_CONFIRM_LIVE_TRADING=1
# SOLANA_ARB_WALLET__KEYPAIR_ENV_VAR=SOLANA_KEYPAIR_BASE58
# SOLANA_ARB_WALLET__EXPECTED_NETWORK=mainnet
# SOLANA_KEYPAIR_BASE58=...   # set on host secret store, not in this file

# ── Strategy toggles (bot matrix) ────────────────────────────────────────────
# SOLANA_ARB_STRATEGY__SCALP=true
# SOLANA_ARB_STRATEGY__ARB=true
# SOLANA_ARB_STRATEGY__WHALE_COPY=false
# SOLANA_ARB_STRATEGY__MOMENTUM=true
# SOLANA_ARB_STRATEGY__SNIPER=false

# ── Risk / execution (optional overrides) ────────────────────────────────────
# SOLANA_ARB_RISK__CAPITAL_USD=10000
# SOLANA_ARB_EXECUTION__MAX_SLIPPAGE_BPS=50
# SOLANA_ARB_SIGNAL_ENGINE__WHALE_THRESHOLD_USD=10000

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=info,control_api=debug
# SOLANA_ARB_MONITORING__LOG_LEVEL=info
# SOLANA_ARB_MONITORING__JSON_LOGS=true

# ── WebSocket batching (control-api /ws) ─────────────────────────────────────
# STREAM_BATCH_MS=33

# ── Future: shared state across replicas (not wired yet) ─────────────────────
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# REDIS_URL=redis://default:password@host:6379
# SIGNAL_BUFFER_CAPACITY=2000
# SIGNAL_DEDUP_TTL_MS=5000
