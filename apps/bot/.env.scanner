# ── Bot — Live Quotes Validation Mode ────────────────────────────────────────
# PURPOSE: Measure REAL Jupiter route divergence without risking capital.
# Execution stays paper (simulated). Real quotes reveal whether the strategy
# has actual edge on mainnet before committing funds.
#
# What this validates:
#   • Real divergenceBps between restricted vs unrestricted Jupiter routes
#   • Real grossSpreadBps after fee compression
#   • Real netProfitUsd per trade at 0.9 SOL notional
#   • Real Jupiter quote latency and 429 behaviour at production scan rate
#
# How to interpret results:
#   avgDivergenceBps > 15  → strong signal, proceed to live execution
#   avgDivergenceBps 5-15  → marginal, reduce size or raise min-profit gate
#   avgDivergenceBps < 5   → no real edge, strategy needs rethink
#
# ── Network ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Mode flags ────────────────────────────────────────────────────────────────
BOT_PAPER_MODE=1       # Keep execution simulated — no on-chain transactions
BOT_LIVE_QUOTES=1      # Use real Jupiter quote API instead of stochastic simulator

# ── Jupiter API (optional but recommended) ────────────────────────────────────
# Free tier: api.jup.ag — aggressive rate limiting (~60 req/min)
# Paid tier: get key at https://portal.jup.ag/ — much higher limits
# With a key, you can increase BOT_SCAN_INTERVAL_MS to 5000 and BOT_PAIRS_PER_SCAN to 3
JUPITER_API_KEY=

# ── Wallet (read-only in paper mode, but required for monitoring) ─────────────
BOT_WALLET_PUBKEY=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE

# ── Strategy ──────────────────────────────────────────────────────────────────
BOT_PRIMARY_STRATEGY=route_divergence_arb
BOT_ENABLE_MEAN_REVERSION=0

# ── Trade sizing — SOL-native validation ─────────────────────────────────────
# 0.9 SOL = ~$58.50 notional (Strategy B sizing, keeps 0.1 SOL for gas)
# All pairs are native Solana — WETH/WBTC/W removed from token list
BOT_TRADE_AMOUNT_UI=0.9

# ── Profit gate ───────────────────────────────────────────────────────────────
# Lower than paper session — we want to see ALL real opportunities, not just top ones
BOT_MIN_PROFIT_USD=0.05

# ── Slippage ──────────────────────────────────────────────────────────────────
BOT_SLIPPAGE_BPS=20

# ── Scan cadence — conservative for public Jupiter rate limits ────────────────
# Without API key: 1 pair × 2 quotes / 15s = 8 req/min (safe for public tier)
# With API key:    3 pairs × 2 quotes / 5s  = 72 req/min (fine for paid tier)
BOT_SCAN_INTERVAL_MS=5000
BOT_PAIR_SOURCE=static
BOT_PAIRS_PER_SCAN=2
BOT_MAX_SCAN_PAIRS=23
BOT_PAIR_QUOTE_MINT=USDC

# ── Route-divergence thresholds (same as paper session) ──────────────────────
BOT_MIN_DIVERGENCE_BPS=5
BOT_MIN_SURVIVING_EDGE_BPS=3

# ── Orca pools ────────────────────────────────────────────────────────────────
ORCA_POOL_ADDRESSES=HJPjoWUrhoZzkNfRpHuieeFk9WcZWjwy6PBjZ81ngndJ,EGZ7tiLeH62TPV1gL8WwbXGzEPa9zmcpVnnkPKKnrE2U
SPREAD_THRESHOLD_BPS=40

# ── Features ──────────────────────────────────────────────────────────────────
BOT_ENABLE_PUMP_EDGE=0
JITO_ENABLED=0

# ── Jupiter endpoints ─────────────────────────────────────────────────────────
JUPITER_SWAP_BASE=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_PORT=3333
LOG_LEVEL=info
SQLITE_PATH=./trades-live-quotes.db

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_PNL_THRESHOLD_SOL=-999

# ── Scanner daemon ────────────────────────────────────────────────────────────
SCANNER_MODE=1
SCANNER_PORT=4444
SCANNER_SCAN_INTERVAL_MS=12000
SCANNER_CAPITAL_USD=150
BOT_PAPER_MODE=1
BOT_LIVE_QUOTES=1
