# ── Bot — Devnet Paper Trading ────────────────────────────────────────────────
# Copy this to .env before running: cp .env.devnet .env
# ALL trades are simulated (no real SOL spent). Safe to run on devnet.

# ── Network ───────────────────────────────────────────────────────────────────
# Devnet public RPC (rate-limited — swap for a Helius/QuickNode devnet URL for
# heavier testing: https://dev.helius-rpc.com/mainnet-beta?api-key=YOUR_KEY)
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Paper mode (REQUIRED — do not set to 0 on devnet) ────────────────────────
BOT_PAPER_MODE=1

# ── Wallet (paper mode only — no private key needed, just a public key) ───────
# Use your Phantom devnet wallet address here. No funds are touched in paper mode.
BOT_WALLET_PUBKEY=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE

# ── Strategy ─────────────────────────────────────────────────────────────────
BOT_PRIMARY_STRATEGY=route_divergence_arb
BOT_TRADE_AMOUNT_UI=0.25
BOT_MIN_PROFIT_USD=0.10
BOT_SLIPPAGE_BPS=50
BOT_SCAN_INTERVAL_MS=4000

# ── Pair universe ─────────────────────────────────────────────────────────────
# Use static pairs on devnet (CMC needs mainnet liquidity data)
BOT_PAIR_SOURCE=static
BOT_PAIRS_PER_SCAN=5
BOT_MAX_SCAN_PAIRS=20

# ── Features (disable live-only features on devnet) ──────────────────────────
BOT_ENABLE_PUMP_EDGE=0
BOT_ENABLE_MEAN_REVERSION=0
JITO_ENABLED=0

# ── Jupiter — mainnet endpoints (quotes still work from devnet environment) ───
# Jupiter does not have a devnet API; it queries mainnet prices for simulation.
JUPITER_SWAP_BASE=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_PORT=3333
LOG_LEVEL=debug
SQLITE_PATH=./trades-devnet.db

# ── Alerts (disabled on devnet) ───────────────────────────────────────────────
ALERT_PNL_THRESHOLD_SOL=-999
