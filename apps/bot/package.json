{
  "name": "@solana-arb/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^9.6.0",
    "bs58": "^5.0.0",
    "express": "^4.19.2",
    "pino": "^9.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^3.0.5",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
