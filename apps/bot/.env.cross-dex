# ── Strategy C: Cross-DEX Arb (Raydium vs Orca) + Pump.fun Memecoin Spreads ──
#
# Measures REAL price differences between Raydium and Orca for the same token.
# Unlike route-divergence (same engine, different modes), this compares two
# genuinely independent DEXes — price gaps are real and exploitable.
#
# Edge sources:
#   1. Core pairs (SOL/USDC, JUP, BONK, mSOL/SOL etc.) — tight but real, ~10–50 bps
#   2. Pump.fun graduated memecoins — wider spreads, 50–500 bps, higher risk
#
# Execution (live mode):
#   Requires Jito bundle: tx1 = buy on cheaperDex, tx2 = sell on dearerDex
#   Both land atomically — no execution-gap risk between legs.
#
# ── Network ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Mode ──────────────────────────────────────────────────────────────────────
BOT_PAPER_MODE=1        # Validate spread reality before going live
BOT_LIVE_QUOTES=1       # Real Jupiter quotes — measures actual Raydium vs Orca spread

# ── Jupiter API ───────────────────────────────────────────────────────────────
JUPITER_API_KEY=jup_0a8454465960ac6f6fb85ef1cfcde88d6d6e335fbc95ac1cd7c1a029e16366b3

# ── Wallet ────────────────────────────────────────────────────────────────────
BOT_WALLET_PUBKEY=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE

# ── Strategy selection ────────────────────────────────────────────────────────
BOT_PRIMARY_STRATEGY=cross_dex_arb
BOT_ENABLE_CROSS_DEX_ARB=1
BOT_ENABLE_PUMP_SPREADS=1       # Enable DexScreener memecoin discovery
BOT_ENABLE_PUMP_EDGE=0          # Bonding curve strategy off (separate from spread arb)
BOT_ENABLE_MEAN_REVERSION=0

# ── Spread thresholds ─────────────────────────────────────────────────────────
# Core pairs (SOL/USDC, JUP etc.): 35 bps = above 30 bps fee floor
# Pump memecoins: 80 bps = wide enough to survive slippage on volatile tokens
BOT_CROSS_DEX_SPREAD_BPS=35
BOT_PUMP_SPREAD_BPS=80

# ── Trade sizing ──────────────────────────────────────────────────────────────
# 0.9 SOL per leg — keeps 0.1 SOL for gas buffer
# At 35 bps spread on $58.50 notional = $0.020 gross profit
# At 80 bps spread on $58.50 notional = $0.047 gross profit
# At 35 bps on 5 SOL ($325 notional) = $0.114 gross profit
BOT_TRADE_AMOUNT_UI=0.9

# ── Profit gate ───────────────────────────────────────────────────────────────
BOT_MIN_PROFIT_USD=0.01         # Low gate — capture all real spread data

# ── Scan cadence ──────────────────────────────────────────────────────────────
# Each pair needs 2 quotes (Raydium + Orca), so pairs/scan × 2 = Jupiter calls/scan
# 8 pairs × 2 quotes × 12 scans/min = 192 req/min (within API key limit)
BOT_SCAN_INTERVAL_MS=5000
BOT_PAIRS_PER_SCAN=8

# ── Execution ─────────────────────────────────────────────────────────────────
BOT_SLIPPAGE_BPS=30

# ── Features ──────────────────────────────────────────────────────────────────
JITO_ENABLED=0          # Enable for live two-tx atomic bundle execution

# ── Jupiter endpoints ─────────────────────────────────────────────────────────
JUPITER_SWAP_BASE=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_PORT=3333
LOG_LEVEL=info
SQLITE_PATH=./trades-cross-dex.db

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_PNL_THRESHOLD_SOL=-0.05
