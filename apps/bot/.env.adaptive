# ── Strategy D: Adaptive Arb — capital-aware, auto-scaling, $0.01–$1/trade ────
#
# Starts with whatever capital you have. Trade size, spread threshold, and
# profit gate all adjust automatically as the balance compounds.
#
# Capital stages:
#   Stage 1 (1–3 SOL):   trade 0.5 SOL, need 100+ bps spread (pump pairs only)
#   Stage 2 (3–10 SOL):  trade capital×50%, need 60+ bps spread
#   Stage 3 (10–30 SOL): trade capital×60%, need 35+ bps (core pairs viable)
#   Stage 4 (30+ SOL):   trade capital×70%, need 25+ bps, full strategy suite
#
# Edge sources (in priority order):
#   1. Pump.fun graduated tokens in first 24–48h on Raydium (50–500 bps)
#   2. LST de-peg: mSOL/jitoSOL/bSOL vs fair value (2–15 bps reliable)
#   3. Cross-DEX spread: Raydium vs Orca on core pairs (1–20 bps at Stage 3+)
#
# Capital state persists across restarts in trades-adaptive-capital.db
#
# ── Network ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Mode ──────────────────────────────────────────────────────────────────────
BOT_PAPER_MODE=1               # Validate first — flip to 0 when live
BOT_LIVE_QUOTES=1              # Real Jupiter quotes — measures actual spreads

# ── Jupiter API ───────────────────────────────────────────────────────────────
JUPITER_API_KEY=jup_0a8454465960ac6f6fb85ef1cfcde88d6d6e335fbc95ac1cd7c1a029e16366b3

# ── Wallet ────────────────────────────────────────────────────────────────────
BOT_WALLET_PUBKEY=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE
# Live mode only — set SOLANA_ARB_WALLET_KEY to your base58 or JSON private key

# ── Strategy selection ────────────────────────────────────────────────────────
BOT_PRIMARY_STRATEGY=adaptive_arb
BOT_ENABLE_ADAPTIVE_ARB=1
BOT_ENABLE_CROSS_DEX_ARB=0     # Disabled — adaptive_arb includes cross-dex logic
BOT_ENABLE_PUMP_SPREADS=1      # DexScreener pump.fun token discovery
BOT_ENABLE_PUMP_EDGE=0
BOT_ENABLE_MEAN_REVERSION=0

# ── Capital tracking ──────────────────────────────────────────────────────────
# Set to your actual starting balance. Persists and compounds across restarts.
BOT_STARTING_CAPITAL_SOL=1.0
BOT_MAX_TRADE_SOL=10           # Hard cap per trade regardless of capital

# ── Profit gate ───────────────────────────────────────────────────────────────
# Absolute floor — the adaptive strategy adjusts this per-stage automatically.
# $0.01 is the absolute minimum (below tx cost floor of ~$0.065 at Stage 1).
BOT_MIN_PROFIT_USD=0.01

# ── Scan cadence ──────────────────────────────────────────────────────────────
# 8 pairs × 2 quotes (raydium+orca) × 12 scans/min = 192 req/min (within limit)
BOT_SCAN_INTERVAL_MS=5000
BOT_PAIRS_PER_SCAN=8
BOT_PAIR_SOURCE=static

# ── Execution ─────────────────────────────────────────────────────────────────
BOT_SLIPPAGE_BPS=50            # Higher slippage for pump tokens (volatile)
JITO_ENABLED=0                 # Enable for live atomic two-tx bundle execution
                               # Required in live mode — without Jito, gap risk exists

# ── Jupiter endpoints ─────────────────────────────────────────────────────────
JUPITER_SWAP_BASE=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_PORT=3333
LOG_LEVEL=info
SQLITE_PATH=./trades-adaptive.db

# ── Alerts ────────────────────────────────────────────────────────────────────
# Halt if session loses more than 5% of starting capital
ALERT_PNL_THRESHOLD_SOL=-0.05
