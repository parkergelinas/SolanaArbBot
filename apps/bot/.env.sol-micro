# ── Strategy B: SOL-Native Micro Route Divergence Arb ────────────────────────
# Starting capital: 1.0 SOL (~$65)
# Trade size: 0.9 SOL per tick (0.1 SOL kept as gas buffer)
# Pairs: SOL/USDC primary, SOL/mSOL + SOL/USDT secondary
# Profits accumulate as extra SOL from round-trips — compounds naturally
#
# Compounding path (Solana-native only):
#   1.0 SOL → arb profits → 10 SOL → 50 SOL ($3,250) → ~$15–$30/hr
#   All pairs are native Solana — no Wormhole-bridged tokens (WETH/WBTC excluded)

# ── Network ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Mode ──────────────────────────────────────────────────────────────────────
BOT_PAPER_MODE=1       # Keep paper until live-quotes confirms real divergence
BOT_LIVE_QUOTES=1      # Real Jupiter quotes to measure actual edge

# ── Jupiter API ───────────────────────────────────────────────────────────────
JUPITER_API_KEY=jup_0a8454465960ac6f6fb85ef1cfcde88d6d6e335fbc95ac1cd7c1a029e16366b3

# ── Wallet ────────────────────────────────────────────────────────────────────
BOT_WALLET_PUBKEY=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE

# ── Strategy ──────────────────────────────────────────────────────────────────
BOT_PRIMARY_STRATEGY=route_divergence_arb
BOT_ENABLE_MEAN_REVERSION=0

# ── Sizing — 0.9 SOL per trade, 0.1 SOL gas buffer ───────────────────────────
# At $65/SOL → $58.50 notional per trade
# Expected: ~$0.02–$0.05/trade if real divergence matches simulator
BOT_TRADE_AMOUNT_UI=0.9

# ── Profit gate — lower for smaller notional ──────────────────────────────────
# $0.02 = ~3.4 bps on $58.50 notional (above fee floor)
BOT_MIN_PROFIT_USD=0.02

# ── Execution ─────────────────────────────────────────────────────────────────
BOT_SLIPPAGE_BPS=20

# ── Scan cadence ──────────────────────────────────────────────────────────────
BOT_SCAN_INTERVAL_MS=5000
BOT_PAIR_SOURCE=static
BOT_PAIRS_PER_SCAN=10
BOT_MAX_SCAN_PAIRS=23
BOT_PAIR_QUOTE_MINT=USDC

# ── Route-divergence thresholds ───────────────────────────────────────────────
BOT_MIN_DIVERGENCE_BPS=3     # Lower threshold for SOL pairs (tighter spreads)
BOT_MIN_SURVIVING_EDGE_BPS=2

# ── Features ──────────────────────────────────────────────────────────────────
BOT_ENABLE_PUMP_EDGE=0
JITO_ENABLED=0

# ── Jupiter endpoints ─────────────────────────────────────────────────────────
JUPITER_SWAP_BASE=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# ── Orca pools ────────────────────────────────────────────────────────────────
ORCA_POOL_ADDRESSES=HJPjoWUrhoZzkNfRpHuieeFk9WcZWjwy6PBjZ81ngndJ,EGZ7tiLeH62TPV1gL8WwbXGzEPa9zmcpVnnkPKKnrE2U
SPREAD_THRESHOLD_BPS=20

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_PORT=3333
LOG_LEVEL=info
SQLITE_PATH=./trades-sol-micro.db

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_PNL_THRESHOLD_SOL=-0.05   # Halt if session loses >0.05 SOL
