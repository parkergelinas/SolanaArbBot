# ── Vercel / production ───────────────────────────────────────────────────────
# Server-side only — Next.js rewrites proxy /api/* to this backend.
CONTROL_API_URL=https://your-control-api.example.com

# Client-side WebSocket (must be wss:// in production).
NEXT_PUBLIC_WS_URL=wss://your-control-api.example.com/ws

# Optional: bypass the /api proxy and call the API directly from the browser.
# NEXT_PUBLIC_API_URL=https://your-control-api.example.com

# ── Market stream (terminal) ──────────────────────────────────────────────────
# Low-latency swap/price/candle feed from stream-api.
NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream

# ── Local dev ─────────────────────────────────────────────────────────────────
# CONTROL_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
# NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream
