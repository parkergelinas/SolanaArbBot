# ── Dashboard (apps/dashboard) ──────────────────────────────────────────────
# Copy to .env.local for local dev.

# Control plane REST proxy (server-side rewrites in next.config.js)
CONTROL_API_URL=http://localhost:3001

# Control-plane WebSocket (overview, bot status)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Terminal market stream (stream-api)
NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream

# Intelligence / whale feed
NEXT_PUBLIC_INTELLIGENCE_URL=ws://localhost:8090/intelligence

# Solana wallet (mainnet-beta recommended for Phantom/Solflare)
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Terminal demo simulator — set 0 when stream-api is running
NEXT_PUBLIC_TERMINAL_DEMO=0

# Optional DexScreener API base override
# NEXT_PUBLIC_DEXSCREENER_API=https://api.dexscreener.com/latest/dex
