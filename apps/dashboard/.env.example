# Local development — copy to .env.local
CONTROL_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream
NEXT_PUBLIC_INTELLIGENCE_URL=ws://localhost:8090/intelligence
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# ── Vercel production (set in Vercel UI, then REDEPLOY) ─────────────────────
# CONTROL_API_URL=https://control-api.your-host.example.com
# NEXT_PUBLIC_WS_URL=wss://control-api.your-host.example.com/ws
# NEXT_PUBLIC_STREAM_URL=wss://stream-api.your-host.example.com/stream
# NEXT_PUBLIC_INTELLIGENCE_URL=wss://intelligence.your-host.example.com/intelligence
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet

# Optional: call API directly from browser (skips same-origin /api proxy)
# NEXT_PUBLIC_API_URL=https://control-api.your-host.example.com

# Env changes require a new deployment — see docs/deploy-control-api.md
