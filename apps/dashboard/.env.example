# ── Dashboard (apps/dashboard) ──────────────────────────────────────────────
# Copy to .env.local for local dev / devnet testing.

# ── Wallet authentication ────────────────────────────────────────────────────
# Comma-separated list of approved Solana wallet public keys (base58).
# Leave unset to use the built-in default (owner wallet).
# Set to "*" or "disabled" to allow any wallet (dev only).
APPROVED_WALLETS=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE

# Secret used to sign session JWTs. Must be set in production.
# Generate one with: openssl rand -hex 32
# AUTH_SECRET=change-me-to-a-random-secret

# Control plane REST proxy (server-side rewrites in next.config.js)
CONTROL_API_URL=http://localhost:3001
# Shared secret forwarded server-side only (required when control-api sets CONTROL_API_KEY)
# CONTROL_API_KEY=your-shared-secret

# Control-plane WebSocket (overview, bot status)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Terminal market stream (stream-api) — REQUIRED for live swaps/signals
NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream
# stream-api REST (pump scanner, solscan researcher) — defaults from WS URL
NEXT_PUBLIC_STREAM_HTTP_URL=http://localhost:8080

# Intelligence / whale feed
NEXT_PUBLIC_INTELLIGENCE_URL=ws://localhost:8090/intelligence

# Solana wallet cluster — use devnet for testing
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# Demo simulator — MUST stay 0 for production / real data (opt-in with =1)
NEXT_PUBLIC_TERMINAL_DEMO=0

# Paper trading UI (simulated fills, real DexScreener prices)
NEXT_PUBLIC_PAPER_TRADING=1

# Optional DexScreener API base override
# NEXT_PUBLIC_DEXSCREENER_API=https://api.dexscreener.com/latest/dex
