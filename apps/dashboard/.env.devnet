# ── Dashboard — Devnet Paper Trading ─────────────────────────────────────────
# Copy to .env.local: cp .env.devnet .env.local

# ── Wallet auth ───────────────────────────────────────────────────────────────
# Your Phantom devnet wallet public key (base58). Only this key can log in.
APPROVED_WALLETS=127fFEvPQ4FtaLQGmNC9MNQBPA6UJ9HftndJNxJNDVJE

# Session JWT secret — generate once with: openssl rand -hex 32
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Network ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# ── Backend connections ───────────────────────────────────────────────────────
# Control-plane (bot REST API + WebSocket)
CONTROL_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Terminal market stream (stream-api) — paper trading works without this,
# but live signal feed requires it running locally.
NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream
NEXT_PUBLIC_STREAM_HTTP_URL=http://localhost:8080

# Intelligence / whale feed (optional)
NEXT_PUBLIC_INTELLIGENCE_URL=ws://localhost:8090/intelligence

# ── Paper trading ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAPER_TRADING=1
NEXT_PUBLIC_TERMINAL_DEMO=0
