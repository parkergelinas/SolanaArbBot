# ─── Dashboard (Vercel / local) ───────────────────────────────────────────────
CONTROL_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream
NEXT_PUBLIC_INTELLIGENCE_URL=ws://localhost:8090/intelligence

# ─── Signal hub (stream-api mirrors control-api) ───────────────────────────────
SIGNAL_HUB_URL=http://127.0.0.1:3001
SIGNAL_BUFFER_PERSIST=true
SIGNAL_DEDUP_TTL_MS=60000

# ─── Free live data APIs ─────────────────────────────────────────────────────
SOLANA_ARB_DATA_SOURCES__HELIUS_API_KEY=your_free_key_from_helius_dev

# ─── Live chain ingestion (data-layer) ───────────────────────────────────────
# auto | mock | rpc | geyser
DATA_LAYER_INGEST=auto
SOLANA_ARB_RPC__ENDPOINTS=https://api.mainnet-beta.solana.com
# Optional dedicated WS endpoint (http URLs are auto-upgraded to wss)
# SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# ─── control-api dev shortcuts ───────────────────────────────────────────────
# CONTROL_USE_MOCK=1
# INTELLIGENCE_BRIDGE=in_process

# ─── execution-engine / arb-engine ───────────────────────────────────────────
EXECUTION_SIGNAL_HUB=1
ARB_USE_SIGNAL_HUB=1
SIGNAL_HUB_POLL_MS=1000
