# ── SolanaArbBot — local development environment ─────────────────────────────
# Copy to .env and export before running Rust services, or use per-shell exports.

# ── stream-api (port 8080) ───────────────────────────────────────────────────
STREAM_API_PORT=8080
STREAM_BATCH_MS=33
# Live chain via data-layer (default). Set 1 only for offline mock swaps.
STREAM_USE_MOCK=0
# Jupiter USD quotes pushed over WS (500 ms poll)
STREAM_JUPITER_POLL_MS=500

# ── data-layer / Helius (free tier at helius.dev) ───────────────────────────
SOLANA_ARB_DATA_SOURCES__HELIUS_API_KEY=
# Solscan researcher API key (used by scanner pollers)
SOLSCAN_API_KEY=
# Force RPC log subscription: auto | mock | rpc | geyser
DATA_LAYER_INGEST=auto
# Alternative RPC endpoints (comma-separated)
# SOLANA_ARB_RPC__ENDPOINTS=https://api.mainnet-beta.solana.com

# ── control-api (port 3001) ──────────────────────────────────────────────────
CONTROL_API_PORT=3001
# Mirror live signals into stream-api when both run locally
SIGNAL_HUB_URL=http://127.0.0.1:3001
SIGNAL_HUB_POLL_MS=1000

# ── dashboard (see apps/dashboard/.env.example) ──────────────────────────────
# NEXT_PUBLIC_STREAM_URL=ws://localhost:8080/stream
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_TERMINAL_DEMO=0
