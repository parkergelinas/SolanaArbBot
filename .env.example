# ── SolanaArbBot — environment reference ──────────────────────────────────────
# Copy to .env, fill in secrets, never commit .env to git.
# All variables with a default are optional — only secrets are required.

# ╔═══════════════════════════════════════════════════════════════╗
# ║  REQUIRED SECRETS — must be set in production                 ║
# ╚═══════════════════════════════════════════════════════════════╝

# Solana wallet private key.
# Accepts two formats:
#   Base58-encoded 64-byte secret key (output of `solana-keygen new --outfile /dev/stdout`)
#   JSON array of 64 bytes: [12,34,...] (standard Solana keypair.json format)
# NEVER commit this value. Use a secret manager (Doppler, AWS Secrets Manager, etc.)
SOLANA_ARB_WALLET_KEY=

# Corresponding wallet public key (used for balance queries; not secret).
BOT_WALLET_PUBKEY=

# Helius RPC API key — required for Pump.fun launch monitoring.
# Get a free key at https://helius.dev
HELIUS_API_KEY=
# Alternative env name accepted by the data-layer bridge:
# SOLANA_ARB_DATA_SOURCES__HELIUS_API_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  SOLANA RPC                                                   ║
# ╚═══════════════════════════════════════════════════════════════╝

# Primary RPC endpoint. Default is public mainnet-beta (rate-limited).
# Use a dedicated endpoint (Helius, Triton, QuikNode) for production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ╔═══════════════════════════════════════════════════════════════╗
# ║  JUPITER API                                                  ║
# ╚═══════════════════════════════════════════════════════════════╝

JUPITER_SWAP_BASE=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2
# Optional paid-tier API key for higher rate limits:
# JUPITER_API_KEY=

# ╔═══════════════════════════════════════════════════════════════╗
# ║  TRADING PARAMETERS                                           ║
# ╚═══════════════════════════════════════════════════════════════╝

# Slippage tolerance in basis points. Default 50 (0.5%).
BOT_SLIPPAGE_BPS=50

# Minimum net profit in USD required to execute a trade. Default $0.25.
BOT_MIN_PROFIT_USD=0.25

# Minimum net profit in lamports (1 SOL = 1_000_000_000 lamports).
# Acts as a hard floor before fee check. Set 0 to disable.
MIN_PROFIT_LAMPORTS=0

# Default swap size in UI units of the input token. Default 1 (1 SOL or 1 token).
BOT_TRADE_AMOUNT_UI=1

# Scan loop interval in ms. Default 2000 ms.
BOT_SCAN_INTERVAL_MS=2000

# Set 0 to enable live trading. Default 1 (paper mode — no real transactions).
BOT_PAPER_MODE=1

# ╔═══════════════════════════════════════════════════════════════╗
# ║  STRATEGY SELECTION                                           ║
# ╚═══════════════════════════════════════════════════════════════╝

# Primary strategy: route_divergence_arb | round_trip_quote_arb | pump_edge
BOT_PRIMARY_STRATEGY=route_divergence_arb

# Enable/disable individual strategies (1 = on, 0 = off):
BOT_ENABLE_PUMP_EDGE=1
BOT_ENABLE_MEAN_REVERSION=0
BOT_ENABLE_TRIGGER_API=0
BOT_ENABLE_RECURRING_API=0

# ╔═══════════════════════════════════════════════════════════════╗
# ║  PAIR UNIVERSE (CoinMarketCap)                                ║
# ╚═══════════════════════════════════════════════════════════════╝

# Set to use live CMC rankings. Leave blank to use the built-in static map.
CMC_API_KEY=
# Alternative:
# COINMARKETCAP_API_KEY=

# Pair source: cmc (live API) | static (built-in list). Auto-detected from CMC_API_KEY.
# BOT_PAIR_SOURCE=static

BOT_MAX_SCAN_PAIRS=100
BOT_PAIRS_PER_SCAN=10
BOT_PAIR_QUOTE_MINT=USDC
BOT_CMC_TOP_N=100

# ╔═══════════════════════════════════════════════════════════════╗
# ║  MEV PROTECTION (Jito)                                        ║
# ╚═══════════════════════════════════════════════════════════════╝

# Enable Jito bundle submission for atomic execution. Default 0 (disabled).
JITO_ENABLED=0

# Jito tip amount in lamports added per bundle. Default 10000 (0.00001 SOL).
# Must be less than estimated profit — the bot enforces this automatically.
JITO_TIP_LAMPORTS=10000

# ╔═══════════════════════════════════════════════════════════════╗
# ║  ORCA WHIRLPOOL MONITORING                                    ║
# ╚═══════════════════════════════════════════════════════════════╝

# Comma-separated Orca Whirlpool pool addresses to monitor via WebSocket.
# Example (SOL/USDC 0.05% pool on mainnet):
# ORCA_POOL_ADDRESSES=HJPjoWUrhoZzkNfRpHuieeFk9WcZWjwy6PBjZ81ngndJ

ORCA_POOL_ADDRESSES=

# Spread in bps above which an arb opportunity event is emitted. Default 80 (0.8%).
SPREAD_THRESHOLD_BPS=80

# ╔═══════════════════════════════════════════════════════════════╗
# ║  MONITORING DASHBOARD                                         ║
# ╚═══════════════════════════════════════════════════════════════╝

# Port for the Express monitoring server. Default 3333.
# Endpoints: GET /status  GET /trades  GET /health
MONITOR_PORT=3333

# ╔═══════════════════════════════════════════════════════════════╗
# ║  ALERTS (Telegram / Discord)                                  ║
# ╚═══════════════════════════════════════════════════════════════╝

# Telegram: create a bot at https://t.me/BotFather and get the chat ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord: create an Incoming Webhook in Server Settings → Integrations.
# DISCORD_WEBHOOK_URL=

# PnL drop in SOL that triggers an alert (negative number). Default -0.1 SOL.
ALERT_PNL_THRESHOLD_SOL=-0.1

# ╔═══════════════════════════════════════════════════════════════╗
# ║  OBSERVABILITY                                                ║
# ╚═══════════════════════════════════════════════════════════════╝

# Pino log level: trace | debug | info | warn | error | fatal. Default info.
LOG_LEVEL=info

# Path to the SQLite trade log. Default ./trades.db (relative to cwd).
SQLITE_PATH=./trades.db

# ╔═══════════════════════════════════════════════════════════════╗
# ║  STREAM-API / CONTROL-API (Rust services)                     ║
# ╚═══════════════════════════════════════════════════════════════╝

STREAM_API_PORT=8080
STREAM_BATCH_MS=33
STREAM_USE_MOCK=0
STREAM_JUPITER_POLL_MS=500

CONTROL_API_PORT=3001
SIGNAL_HUB_URL=http://127.0.0.1:3001
SIGNAL_HUB_POLL_MS=1000

# Restrict control-api to requests bearing this key (recommended for production).
# CONTROL_API_KEY=change-me-before-production

# ╔═══════════════════════════════════════════════════════════════╗
# ║  SOLSCAN (optional scanner enrichment)                        ║
# ╚═══════════════════════════════════════════════════════════════╝

# SOLSCAN_API_KEY=
